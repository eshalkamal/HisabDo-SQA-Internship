    {
      "name": "API-TC-01 Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"API request is successful\", function () {\r",
              "    pm.expect(response.isSuccess).to.eql(true);\r",
              "});\r",
              "\r",
              "pm.test(\"Products data is available\", function () {\r",
              "    pm.expect(response.data.data).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Product list is not empty\", function () {\r",
              "    pm.expect(response.data.data.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Product contains required fields\", function () {\r",
              "    const product = response.data.data[0];\r",
              "\r",
              "    pm.expect(product).to.have.property(\"id\");\r",
              "    pm.expect(product).to.have.property(\"name\");\r",
              "    pm.expect(product).to.have.property(\"price\");\r",
              "    pm.expect(product).to.have.property(\"sku\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
